[Unit]
Description=OBS HomeRun - Virtual HDTV Tuner for Smart TVs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/bin
ExecStart=%h/.local/bin/obs-homerun
Restart=on-failure
RestartSec=5
Environment="FRIENDLY_NAME=OBS HomeRun"
Environment=CHANNEL_NUMBER=1.1
Environment=BUFFER_SECONDS=3.0

[Install]
WantedBy=default.target
